# Python Bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Streamlit Configuration & Secrets
# Keep config.toml and secrets.toml.example in Git, but NEVER commit real secrets:
.streamlit/secrets.toml

# Environment & Credentials
.env
*.env
.env.*

# Local SQLite databases (keeps repository clean and prevents committing personal user data)
data/*.db
*.sqlite
*.sqlite3

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.log
*.zip
