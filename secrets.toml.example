# ==============================================================================
# Streamlit Secrets Template for HackAware
# ==============================================================================
#
# LOCAL USAGE:
# If testing persistent PostgreSQL locally, copy this file to:
#   .streamlit/secrets.toml
# and fill in your Supabase or PostgreSQL database URL.
# (Note: .streamlit/secrets.toml is gitignored and will never be pushed to GitHub)
#
# STREAMLIT COMMUNITY CLOUD DEPLOYMENT:
# In your Streamlit Cloud app dashboard:
#   Go to "App Settings" -> "Secrets" -> Paste the key below:
#
# DATABASE_URL = "postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
#
# If left commented or empty, HackAware automatically uses local SQLite (data/hackaware.db).
# ==============================================================================

# DATABASE_URL = "postgresql://postgres:yourpassword@db.yourproject.supabase.co:5432/postgres"
